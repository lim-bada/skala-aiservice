  "cases": [
    {
      "id": "dev_cpu_ge",
      "split": "dev",
      "query": "payments-service를 조회하고 CPU가 80% 이상이면 CPU 런북을, 아니면 메모리 런북을 확인해줘.",
      "supported": true,
      "expected_definition": {
