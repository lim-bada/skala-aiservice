        "name": "dev_cpu_ge",
        "steps": [
          {
            "id": "metrics",
            "type": "monitoring",
            "system": "payments-service"
          },
          {
            "id": "branch",
            "type": "if",
            "condition": {
              "ref": "metrics",
              "field": "cpu_percent",
              "op": ">=",
              "value": 80
            },
            "then_steps": [
              {
                "id": "cpu",
