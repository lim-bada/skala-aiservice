# [추가] .env에 설정하면 별도 환경변수 없이 ./.venv/bin/python3 server.py로 실행한다.
# [추가] 전환: OpenAI는 openai, Ollama는 ollama로 아래 값을 바꾼 뒤 백엔드를 재시작한다.
LLM_BACKEND=openai

# [수정] 기존 실행 스크립트와 호환되는 LANGCHAIN_* 이름으로 LangSmith 설정을 통일한다.
# 같은 용도의 LANGSMITH_* 별칭을 중복 설정하지 않는다.
# 실제 API 키는 .env에 넣는다 (.env는 git에 커밋하지 않음).
# 필요한 설정을 실제 .env에 반영하고 아래 API 키 예시를 본인 키로 바꾼다.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=capstone-all-total-openai
# [추가] Ollama 기록을 분리하려면 위 프로젝트 이름도 capstone-all-total-ollama로 바꾼다.

# [수정] 기본 endpoint는 SDK가 제공한다. 다른 리전·자체 서버를 사용할 때만 별도로 지정한다.
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# [수정] OpenAI 백엔드의 실제 API 키를 .env에 설정한다. 요청 시 API 사용료가 발생한다.
OPENAI_API_KEY=sk-...
# 기본값: fast=gpt-4o-mini, quality=gpt-4o (원하면 아래로 재정의)
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o

# [추가] 조건부 워크플로 생성은 일반 진단의 소형 fast 모델과 별도로 선택한다.
# 미설정 시 Ollama quality 모델을 사용하며 기본값은 qwen3:8b다.
# OLLAMA_WORKFLOW_MODEL=qwen3:8b
